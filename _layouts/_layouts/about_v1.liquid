---
layout: default
---
<div class="post">

  <div class="profile-header-wrapper">
    {% if page.profile %}
      {% if page.profile.image %}
        <div class="profile-image-container">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% comment %} {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %} {% endcomment %}
            {% assign profile_image_class = 'img-fluid z-depth-1' %}
          {% endif %}
          {% comment %} Adjust sizes attribute based on your desired image size and layout {% endcomment %}
        {% comment %} {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3 }}px, (min-width: 576px) 30vw, 40vw"{% endcapture %} {% endcomment %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
          {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image cache_bust=true %}
        </div>
      {% endif %}
    {% endif %}

    <div class="profile-header-content">
      <header class="post-header">
        <h1 class="post-title">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }} {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        {% if page.subtitle %}
          <p class="desc">{{ page.subtitle }}</p>
        {% endif %}
      </header>

      <div class="contact-info">
        {% if site.email %}
        {% comment %} <p><i class="fas fa-envelope"></i>&nbsp; <a href="mailto:{{ site.email }}">{{ site.email }}</a></p> {% endcomment %}
        <p> {{ site.email }}</p>
        {% endif %}
        {% if site.office %}
        {% comment %} <p><i class="fas fa-map-marker-alt"></i>&nbsp; {{ site.office }}</p> {% endcomment %}
        <p> {{ site.office }}</p>
        {% endif %}
        {% if site.phone %}
        {% comment %} <p><i class="fas fa-phone"></i>&nbsp; {{ site.phone }}</p> {% endcomment %}
        <p> {{ site.phone }}</p>
        {% endif %}
      </div>

      {% if page.social %}
        <div class="social">
          {% if site.contact_note %}
            <div class="contact-note">{{ site.contact_note }}</div>
          {% endif %}
          <div class="contact-icons">{% include social.liquid %}</div>
        </div>
      {% endif %}

      {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
      {% endif %}
    </div>

  </div> <article class="post-content">
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <hr>
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <hr>
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <hr>
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}">「Full List」</a></a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

      {% if site.newsletter and site.newsletter.enabled %}
      <hr>
      {% include newsletter.liquid center=true %}
    {% endif %}

  </article>
</div>